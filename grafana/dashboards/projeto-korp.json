              "SVGBaseFix": true,
              "add100Percentage": true,
              "calcsMutation": "standard",
              "centerAlignContent": true,
              "codeData": "{\n  \"text\": \"Random text\"\n}",
              "css": ".wrap { display:flex; align-items:center; gap:16px; padding:0 16px; font-family: 'Segoe UI', Arial, sans-serif; }\n.dot { width:26px; height:26px; border-radius:50%; background:#666; box-shadow:0 0 12px rgba(0,0,0,0.4); transition: background 0.3s ease; }\n.dot.up { background:#2ecc71; box-shadow:0 0 14px #2ecc71; }\n.dot.down { background:#e74c3c; box-shadow:0 0 14px #e74c3c; }\n.label { font-size:20px; font-weight:600; color:#fff; }\n.sub { font-size:12px; color:#9aa0a6; margin-top:2px; }",
              "dynamicData": false,
              "dynamicFieldDisplayValues": false,
              "dynamicHtmlGraphics": false,
              "dynamicProps": false,
              "html": "<div class=\"wrap\">\n  <div id=\"dot\" class=\"dot\"></div>\n  <div class=\"info\">\n    <div id=\"label\" class=\"label\">Verificando...</div>\n    <div id=\"sub\" class=\"sub\">Instancia: -</div>\n  </div>\n</div>",
              "onInit": "",
              "onInitOnResize": false,
              "onRender": "const dot = htmlNode.getElementById('dot');\nconst label = htmlNode.getElementById('label');\nconst sub = htmlNode.getElementById('sub');\n\nif (!data.series || data.series.length === 0) {\n  label.textContent = 'Sem dados';\n  dot.className = 'dot';\n} else {\n  const serie = data.series[0];\n  const valueField = serie.fields[1];\n  const lastIndex = valueField.values.length - 1;\n  const value = valueField.values.get(lastIndex);\n  const instanceLabel = serie.fields[1].labels ? (serie.fields[1].labels.instance || serie.fields[1].labels.job || '-') : '-';\n\n  if (value === 1) {\n    dot.className = 'dot up';\n    label.textContent = 'ONLINE';\n  } else {\n    dot.className = 'dot down';\n    label.textContent = 'OFFLINE';\n  }\n  sub.textContent = 'Instancia: ' + instanceLabel;\n}",
              "overflow": "visible",
              "panelupdateOnMount": true,
              "reduceOptions": {
                "calcs": [
                  "lastNotNull",
                  "last",
                  "firstNotNull",
                  "first",
                  "min",
                  "max",
                  "mean",
                  "sum",
                  "count",
                  "range",

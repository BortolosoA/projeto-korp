              },
              "overrides": []
            },
            "options": {
              "SVGBaseFix": true,
              "add100Percentage": true,
              "calcsMutation": "standard",
              "centerAlignContent": true,
              "codeData": "{\n  \"text\": \"Random text\"\n}",
              "css": ".status-card { padding:0 18px; font-family:'Segoe UI', Arial, sans-serif; color:#fff; }\n.row { display:flex; justify-content:space-between; padding:6px 0; border-bottom:1px solid #2a2d34; font-size:14px; }\n.row:last-child { border-bottom:none; }\n.k { color:#9aa0a6; }\n.v { font-weight:600; }\n.v.ok { color:#2ecc71; }\n.v.bad { color:#e74c3c; }",
              "dynamicData": false,
              "dynamicFieldDisplayValues": false,
              "dynamicHtmlGraphics": false,
              "dynamicProps": false,
              "html": "<div class=\"status-card\">\n  <div class=\"row\">\n    <span class=\"k\">Scrape Time</span>\n    <span id=\"p3-uptime\" class=\"v\">--</span>\n  </div>\n  <div class=\"row\">\n    <span class=\"k\">Requisicoes</span>\n    <span id=\"p3-rate\" class=\"v\">--</span>\n  </div>\n  <div class=\"row\">\n    <span class=\"k\">Taxa de erro (5xx)</span>\n    <span id=\"p3-error\" class=\"v\">--</span>\n  </div>\n</div>",
              "onInit": "",
              "onInitOnResize": false,
              "onRender": "function lastValue(refId) {\n  const serie = (data.series || []).find((s) => s.refId === refId);\n  if (!serie) return null;\n  const field = serie.fields[1];\n  const idx = field.values.length - 1;\n  return idx >= 0 ? field.values.get(idx) : null;\n}\n\nfunction firstValue() {\n  const serie = (data.series || []).find((s) => s.name && s.name.includes('process_start'));\n  if (!serie) return null;\n  const field = serie.fields.find(f => f.type === 'number') || serie.fields[1];\n  if (!field || !field.values || field.values.length === 0) return null;\n  const idx = field.values.length - 1;\n  return typeof field.values.get === 'function' \n    ? field.values.get(idx) \n    : field.values[idx];\n}\n\nconst uptimeStart = firstValue();\nconst rateVal = lastValue('C');\nconst errVal = lastValue('D');\n\nconst uptimeEl = htmlNode.getElementById('p3-uptime');\nconst rateEl = htmlNode.getElementById('p3-rate');\nconst errorEl = htmlNode.getElementById('p3-error');\n\n\nrateEl.textContent = rateVal != null ? rateVal : 'N/D';\n\nif (errVal != null) {\n  const pct = rateVal ? (errVal / rateVal) * 100 : 0;\n  errorEl.textContent = pct.toFixed(2) + ' %';\n  errorEl.className = pct > 5 ? 'v bad' : 'v ok';\n} else {\n  errorEl.textContent = 'N/D';\n}",
              "overflow": "visible",
              "panelupdateOnMount": true,
              "reduceOptions": {
                "calcs": [
                  "lastNotNull",
                  "last",
                  "firstNotNull",
                  "first",
                  "min",
                  "max",
                  "mean",
                  "sum",
                  "count",
                  "range",
                  "delta",
                  "step",
                  "diff",
                  "logmin",
                  "allIsZero",
                  "allIsNull",
                  "diffperc"
                ]
              },
              "renderOnMount": true,
              "rootCSS": "",
              "useGrafanaScrollbar": true
            }
          },
          "version": "2.2.3"
        }
      }
    },

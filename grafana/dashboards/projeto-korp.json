              },
              "overrides": []
            },
            "options": {
              "SVGBaseFix": true,
              "add100Percentage": true,
              "calcsMutation": "standard",
              "centerAlignContent": true,
              "codeData": "{\n  \"text\": \"Random text\"\n}",
              "css": ".dash-container {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));\n  gap: 5px;\n  width: 80%;\n  height: 100%;\n  padding: 4px;\n  box-sizing: border-box;\n  font-family: inherit;\n}\n\n.card {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  background: rgba(255,255,255,0.04);\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 10px;\n  padding: 8px;\n}\n\n.card.wide {\n  grid-column: 1 / -1;\n  background: rgba(87,148,242,0.12);\n  border-color: rgba(87,148,242,0.3);\n}\n\n.card-label {\n  font-size: 12px;\n  opacity: 0.65;\n  text-transform: uppercase;\n  letter-spacing: 0.03em;\n}\n\n.card-value {\n  font-size: 20px;\n  font-weight: 600;\n  margin-top: 2px;\n}",
              "dynamicData": false,
              "dynamicFieldDisplayValues": false,
              "dynamicHtmlGraphics": false,
              "dynamicProps": false,
              "html": "<div class=\"dash-container\">\n\n  <div class=\"card wide\">\n    <div>\n      <div class=\"card-label\">Uptime</div>\n      <div class=\"card-value\" id=\"val-uptime\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">Goroutines</div>\n      <div class=\"card-value\" id=\"val-goroutines\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">OS Threads</div>\n      <div class=\"card-value\" id=\"val-threads\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">Memória em Uso</div>\n      <div class=\"card-value\" id=\"val-resident\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">Memória virtual</div>\n      <div class=\"card-value\" id=\"val-virtual\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">Heap</div>\n      <div class=\"card-value\" id=\"val-heap\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">Objetos no heap</div>\n      <div class=\"card-value\" id=\"val-heapobjects\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">Próximo GC</div>\n      <div class=\"card-value\" id=\"val-nextgc\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">GC médio</div>\n      <div class=\"card-value\" id=\"val-gc\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">CPU total (s)</div>\n      <div class=\"card-value\" id=\"val-cpu\">--</div>\n    </div>\n  </div>\n\n  <div class=\"card\">\n    <div>\n      <div class=\"card-label\">File descriptors</div>\n      <div class=\"card-value\" id=\"val-fds\">--</div>\n    </div>\n  </div>\n</div>",
              "onInit": "",
              "onInitOnResize": false,
              "onRender": "const getMetric = (name) => {\n  const series = htmlGraphics.data.series.find((s) => s.refId === name);\n  if (!series || !series.fields[1]) return null;\n  const last = series.fields[1].state?.calcs?.last;\n  return last == null ? null : last;\n};\n\nconst setVal = (id, text) => {\n  const el = htmlGraphics.htmlNode.querySelector(id);\n  if (el) el.textContent = text;\n};\n\nconst fmtBytes = (bytes) => {\n  if (bytes == null) return '--';\n  const units = ['B', 'KB', 'MB', 'GB', 'TB'];\n  let i = 0;\n  while (bytes >= 1024 && i < units.length - 1) {\n    bytes /= 1024;\n    i++;\n  }\n  return bytes.toFixed(2) + ' ' + units[i];\n};\n\nconst fmtUptime = (startTimeSeconds) => {\n  if (startTimeSeconds == null) return '--';\n  let diff = Math.floor(Date.now() / 1000 - startTimeSeconds);\n  if (diff < 0) diff = 0;\n  const d = Math.floor(diff / 86400);\n  const h = Math.floor((diff % 86400) / 3600);\n  const m = Math.floor((diff % 3600) / 60);\n  const s = diff % 60;\n  const parts = [];\n  if (d) parts.push(d + 'd');\n  if (h || d) parts.push(h + 'h');\n  if (m || h || d) parts.push(m + 'm');\n  parts.push(s + 's');\n  return parts.join(' ');\n};\n\n// Uptime\nsetVal('#val-uptime', fmtUptime(getMetric('start_time')));\n\n// Goroutines / Threads\nsetVal('#val-goroutines', getMetric('go_goroutines') ?? '--');\nsetVal('#val-threads', getMetric('go_threads') ?? '--');\n\n// Memória\nsetVal('#val-resident', fmtBytes(getMetric('resident_memory')));\nsetVal('#val-virtual', fmtBytes(getMetric('virtual_memory')));\nsetVal('#val-heap', fmtBytes(getMetric('heap_alloc')));\nsetVal('#val-heapobjects', getMetric('heap_objects') ?? '--');\nsetVal('#val-nextgc', fmtBytes(getMetric('next_gc')));\n\n// GC médio (já vem calculado da query gc_avg_duration, em segundos)\nconst gcAvg = getMetric('gc_avg_duration');\nsetVal('#val-gc', gcAvg == null ? '--' : (gcAvg * 1000).toFixed(2) + ' ms');\n\n// CPU\nconst cpu = getMetric('cpu_seconds');\nsetVal('#val-cpu', cpu == null ? '--' : cpu.toFixed(2) + ' s');\n\n// File descriptors\nconst openFds = getMetric('open_fds');\nconst maxFds = getMetric('max_fds');\nsetVal('#val-fds', openFds == null ? '--' : `${openFds} / ${maxFds ?? '?'}`);\n\n// HTTP\nsetVal('#val-http', getMetric('http_requests') ?? '--');\nsetVal('#val-scrapes', getMetric('scrape_requests') ?? '--');",
              "overflow": "visible",
              "panelupdateOnMount": true,
              "reduceOptions": {
                "calcs": [
                  "lastNotNull",
                  "last",
                  "firstNotNull",
                  "first",
                  "min",
                  "max",
                  "mean",
                  "sum",
